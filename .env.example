# Copy to .env next to compose.yaml. BETTER_AUTH_SECRET is required; everything else is optional.

# Host port for the app.
APP_PORT=8080

# Required. Random string, >= 32 chars, e.g. `openssl rand -base64 32`. Signs session cookies.
BETTER_AUTH_SECRET=

# Create the demo user (demo@finance.local / demo-password) on first boot. Existing data is never reset.
SEED_DEMO=true

# Only needed when not accessed via http://localhost:<APP_PORT>, e.g. behind a domain or reverse proxy.
# BETTER_AUTH_URL=https://finance.example.com
# TRUSTED_ORIGINS=https://finance.example.com
