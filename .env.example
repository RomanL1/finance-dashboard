# Copy to .env next to compose.yaml. BETTER_AUTH_SECRET, RESEND_API_KEY and MAIL_FROM are required; everything else is optional.

# Host port for the app.
APP_PORT=8080

# Required. Random string, >= 32 chars, e.g. `openssl rand -base64 32`. Signs session cookies.
BETTER_AUTH_SECRET=

# Required. Sign-up verification and password-reset mails are sent through Resend (https://resend.com)
# from an address on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=Finance Dashboard <noreply@your-domain>

# Create the demo user (demo@finance.local / demo-password) and the sample user with a
# ready household and 200 random transactions (sample@finance.local / sample-password) on first boot. Existing data is never reset.
SEED_DEMO=true

# Only needed when not accessed via http://localhost:<APP_PORT>, e.g. behind a domain or reverse proxy.
# BETTER_AUTH_URL=https://finance.example.com
# TRUSTED_ORIGINS=https://finance.example.com
# Links in mails; defaults to BETTER_AUTH_URL.
# APP_URL=https://finance.example.com
