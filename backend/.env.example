PORT=3000
DB_FILE_NAME=file:local.db
# Optional in dev; the api refuses to start without it in production.
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:4200
# Frontend origin; links in verification and password-reset mails point here. Required in production.
APP_URL=http://localhost:4200
# Resend API key and sender (verified domain). Required in production; without a key in dev,
# mails are printed to the api console (click the link from there).
# RESEND_API_KEY=re_...
# MAIL_FROM=Finance Dashboard <noreply@your-domain>
# Create the demo user on boot. Default: false (dev uses `bun run db:seed`).
# SEED_DEMO=true
# Rate provider for multi-currency analytics (Frankfurter v2 API; self-host with its docker image to go offline).
