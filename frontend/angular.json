{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "bun"
    },
    "newProjectRoot": "projects",
    "projects": {
        "finance-dashboard": {
            "projectType": "application",
            "schematics": {},
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "loader": {
                            ".svg": "text"
                        },
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "styles": [
                            "@fontsource/roboto/300.css",
                            "@fontsource/roboto/400.css",
                            "@fontsource/roboto/500.css",
                            "src/material-theme.scss",
                            "src/styles.css"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": false
                                },
                                "fonts": true
                            },
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "finance-dashboard:build:production"
                        },
                        "development": {
                            "buildTarget": "finance-dashboard:build:development"
                        }
                    },
                    "defaultConfiguration": "development",
                    "options": {
                        "allowedHosts": [
                            "liberally-rutilant-christinia.ngrok-free.dev"
                        ],
                        "proxyConfig": "proxy.conf.json"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "providersFile": "src/test-providers.ts"
                    }
                }
            }
        }
    }
}
