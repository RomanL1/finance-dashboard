# Rendered by the nginx image entrypoint (envsubst on ${API_UPSTREAM} only; nginx's own $vars are untouched).
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Backend API (controllers under /api/*, better-auth under /api/auth/*).
    # Host is forwarded so better-auth sees the public origin (BETTER_AUTH_URL / TRUSTED_ORIGINS).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Angular content-hashed bundles are immutable. Unhashed files (index.html, assets/, favicon) are not.
    location ~* ^/(chunk|main|styles|polyfills)-[A-Za-z0-9_-]+\.(js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA: unknown paths resolve to index.html, which must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
