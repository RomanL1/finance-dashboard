{
    "name": "finance-dashboard",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "prestart": "bun run api:generate",
        "start": "ng serve",
        "build": "ng build",
        "format": "prettier --write \"src/**/*.{ts,html}\" \"playwright/**/*.ts\" playwright.config.ts",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:cov": "ng test --watch=false --coverage",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "api:generate": "openapi-ts",
        "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p playwright/tsconfig.json",
        "lint": "oxlint src/ && bun run typecheck"
    },
    "private": true,
    "packageManager": "bun@1.4.2",
    "dependencies": {
        "@angular/cdk": "^22.1.0",
        "@angular/common": "^22.0.0",
        "@angular/compiler": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/material": "^22.1.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/router": "^22.0.0",
        "@fontsource/roboto": "^5.3.0",
        "@material-symbols/svg-400": "^0.47.2",
        "@ngx-translate/core": "^18.0.0",
        "@ngx-translate/http-loader": "^18.0.0",
        "better-auth": "^1.7.2",
        "chart.js": "^4.5.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.0.1",
        "@angular/cli": "^22.0.1",
        "@angular/compiler-cli": "^22.0.0",
        "@hey-api/openapi-ts": "^0.99.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/node": "^26.5.0",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^28.0.0",
        "oxlint": "^1.80.0",
        "postcss": "^8.5.3",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.1.12",
        "typescript": "~6.0.2",
        "vitest": "^4.0.8"
    }
}
