flowchart TB
  browser(["Browser<br/>phone or desktop"])
  subgraph host ["Docker host · docker compose (compose.yaml)"]
    direction TB
    subgraph web ["container: web · nginx-unprivileged"]
      nginx["nginx :8080<br/>Angular bundle<br/>sets X-Real-IP"]
    end
    subgraph apic ["container: api · oven/bun"]
      nest["bun dist/main.js :3000<br/>migrate → seed? → listen"]
    end
    vol[("volume db-data<br/>/data/local.db")]
  end
  browser -->|"HTTP · host port APP_PORT (8080)"| nginx
  nginx -->|"proxies /api/ · HTTP api:3000"| nest
  nest -->|"reads/writes · libsql file"| vol
  web -. "depends_on: api healthy<br/>(GET /api/health)" .-> apic
  classDef node fill:#4a6fa5,stroke:#2f4a73,color:#ffffff;
  classDef store fill:#e8eef6,stroke:#4a6fa5;
  class nginx,nest node;
  class vol store;
